{
  "name": "kagg/pagespeed-module",
  "description": "PageSpeed Module",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "PageSpeed Module",
    "Mod PageSpeed",
    "ModPageSpeed",
    "Apache",
    "Nginx",
    "cache"
  ],
  "homepage": "https://wordpress.org/plugins/kagg-pagespeed-module/",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "KAGG Design",
      "email": "info@kagg.eu",
      "homepage": "https://kagg.eu/en/"
    }
  ],
  "support": {
    "issues": "https://wordpress.org/support/plugin/kagg-pagespeed-module/"
  },
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.5",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "KAGG\\PagespeedModule\\": "src/php"
    }
  },
  "scripts": {
    "phpcs": "phpcs --colors --standard=phpcs.xml",
    "changelog": "@php .github/scripts/update-changelog.php",
    "changelog:check": "@php .github/scripts/update-changelog.php --check",
    "test:changelog": "@php tests/php/changelog.php"
  }
}
